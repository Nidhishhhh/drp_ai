# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES
# .env is gitignored - this file is safe to commit
# ============================================================

# ============================================================
# App Settings
# ============================================================
APP_NAME="drp.ai"
APP_VERSION="0.1.0"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============================================================
# Server
# ============================================================
HOST=127.0.0.1
PORT=8000

# ============================================================
# File Upload Settings
# ============================================================
UPLOAD_DIR=static/uploads
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ============================================================
# AI Model Settings
# ============================================================
YOLO_MODEL_PATH=models/yolov8n.pt
CLIP_MODEL_NAME=ViT-B/32
DEVICE=cuda                   # cuda for GPU, cpu for fallback

# ============================================================
# FAISS Settings
# ============================================================
FAISS_INDEX_PATH=data/product_index/fashion.index
PRODUCT_CATALOG_PATH=data/product_catalog/products.json
TOP_K_RESULTS=20

# ============================================================
# Database (Phase 8 - fill when setting up PostgreSQL)
# ============================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fashion_search
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/fashion_search

# ============================================================
# Redis (Phase 7 - fill when setting up Redis)
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# JWT Auth (Phase 9)
# ============================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# Cloudflare R2 (Phase 11 - fill when setting up R2)
# ============================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=fashion-search-uploads
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# ============================================================
# Sentry (Phase 13 - fill when setting up Sentry)
# ============================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================
# Scraping Settings (Phase 10)
# ============================================================
SCRAPE_CACHE_TTL_HOURS=6
MAX_SCRAPE_RETRIES=3
SCRAPE_DELAY_SECONDS=2
